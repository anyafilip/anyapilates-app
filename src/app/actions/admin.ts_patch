+export async function updateSession(formData: FormData) {
+  await requireAdmin()
+  const id = formData.get('id') as string
+  const classTypeId = formData.get('classTypeId') as string
+  const date = new Date(formData.get('date') as string)
+  const startTime = formData.get('startTime') as string
+  const endTime = formData.get('endTime') as string
+  const capacity = parseInt(formData.get('capacity') as string, 10)
+  const duration = parseInt(formData.get('duration') as string, 10)
+  const instructorId = formData.get('instructorId') as string || null
+
+  const classType = await prisma.classType.findUniqueOrThrow({ where: { id: classTypeId } })
+  const name = classType.name
+
+  await prisma.class.update({
+    where: { id },
+    data: { name, classTypeId, date, startTime, endTime, capacity, duration, instructorId }
+  })
+  revalidatePath('/', 'layout')
+}
